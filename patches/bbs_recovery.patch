@@ -0,0 +1,25 @@
+#pragma once
+#include <cmath>
+#include <cstddef>
+#include <string>
+
+namespace agt_relocalization {
+// These defaults match global_relocalization.yaml. The wrapper supplies its
+// actual configured gates; its publication checks remain an independent guard.
+struct CandidateGates {
+  double min_score{0.50};
+  double max_fitness{1.00};
+  double min_overlap{0.20};
+};
+inline std::string candidate_rejection(bool converged, std::size_t inliers,
+    bool finite_pose, double score, double fitness, double overlap,
+    const CandidateGates& gates) {
+  if (!converged || !inliers) return "GICP_NON_CONVERGENCE";
+  if (!finite_pose || !std::isfinite(score) || !std::isfinite(fitness) ||
+      !std::isfinite(overlap)) return "GICP_NON_FINITE";
+  if (score < gates.min_score) return "SCORE_LOW";
+  if (fitness > gates.max_fitness) return "FITNESS_HIGH";
+  if (overlap < gates.min_overlap) return "OVERLAP_LOW";
+  return {};
+}
+}  // namespace agt_relocalization
