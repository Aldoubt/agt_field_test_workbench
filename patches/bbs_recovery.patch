--- /dev/null
+++ b/navigation/localization/agt_global_relocalization/agt_global_relocalization/attempt_evidence.py
@@ -0,0 +1,167 @@
+"""Bounded, replayable evidence for one localization attempt (no ROS dependency)."""
+from datetime import datetime, timezone
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import shutil
+import time
+import uuid
+
+
+SCHEMA = 'agt_relocalization_attempt/v1'
+
+
+def _utc_now():
+    return datetime.now(timezone.utc).isoformat(timespec='milliseconds')
+
+
+def _atomic_text(path, text):
+    temporary = path.with_name('.' + path.name + '.' + uuid.uuid4().hex + '.tmp')
+    try:
+        with temporary.open('x', encoding='utf-8') as stream:
+            stream.write(text)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def _text(value):
+    if value is None:
+        return ''
+    if isinstance(value, bytes):
+        return value.decode('utf-8', errors='replace')
+    return str(value)
+
+
+class AttemptEvidence:
+    """Capture an exact query plus process result, retaining completed attempts.
+
+    The caller writes ``query_scan.pcd`` inside ``path``. Arbitrary JSON metadata
+    may be added with ``update``; schema and lifecycle fields are owned here.
+    ``record_backend`` accepts CompletedProcess, or explicit timeout output.
+    Exiting never suppresses the matching exception.
+    """
+
+    def __init__(self, root, keep=20):
+        if isinstance(keep, bool) or not isinstance(keep, int) or keep < 1:
+            raise ValueError('attempt retention must be a positive integer')
+        self.root = Path(root).expanduser()
+        self.keep = keep
+        self.path = None
+        self._fields = {}
+        self._started = None
+
+    def __enter__(self):
+        if self.path is not None:
+            raise RuntimeError('an evidence context cannot be reused')
+        self.root.mkdir(parents=True, exist_ok=True)
+        name = 'attempt_' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ_')
+        self.path = self.root / (name + uuid.uuid4().hex[:12])
+        self.path.mkdir()
+        self._started = time.monotonic()
+        self._fields = {
+            'schema': SCHEMA,
+            'attempt_id': self.path.name,
+            'started_at': _utc_now(),
+            'completed': False,
+            'outcome': 'running',
+        }
+        self._save()
+        return self
+
+    def _save(self):
+        self._fields['updated_at'] = _utc_now()
+        _atomic_text(self.path / 'attempt.json', json.dumps(
+            self._fields, ensure_ascii=False, indent=2, allow_nan=False) + '\n')
+
+    def update(self, **fields):
+        if self.path is None or self._fields.get('completed'):
+            raise RuntimeError('evidence updates require an active context')
+        reserved = {'schema', 'attempt_id', 'started_at', 'updated_at',
+                    'completed_at', 'completed', 'outcome', 'elapsed_sec'}
+        if reserved.intersection(fields):
+            raise ValueError('evidence lifecycle fields cannot be overwritten')
+        # Validate before changing the in-memory record, so one bad field cannot
+        # prevent a later exception and the query hash from being persisted.
+        json.dumps(fields, allow_nan=False)
+        self._fields.update(fields)
+        self._save()
+
+    def record_backend(self, proc=None, *, stdout=None, stderr=None, returncode=None):
+        if self.path is None or self._fields.get('completed'):
+            raise RuntimeError('backend evidence requires an active context')
+        if proc is not None:
+            stdout = getattr(proc, 'stdout', stdout)
+            stderr = getattr(proc, 'stderr', stderr)
+            returncode = getattr(proc, 'returncode', returncode)
+        if returncode is not None and (isinstance(returncode, bool) or
+                                       not isinstance(returncode, int)):
+            raise ValueError('backend returncode must be an integer or None')
+        _atomic_text(self.path / 'backend.stdout', _text(stdout))
+        _atomic_text(self.path / 'backend.stderr', _text(stderr))
+        self.update(backend_returncode=returncode)
+
+    def _prune(self):
+        completed = []
+        for directory in self.root.iterdir():
+            if (not directory.name.startswith('attempt_') or
+                    directory.is_symlink() or not directory.is_dir()):
+                continue
+            metadata = directory / 'attempt.json'
+            if metadata.is_symlink() or not metadata.is_file():
+                continue
+            try:
+                record = json.loads(metadata.read_text(encoding='utf-8'))
+                if (not isinstance(record, dict) or record.get('schema') != SCHEMA or
+                        record.get('completed') is not True):
+                    continue
+                completed.append((directory.stat().st_mtime_ns, directory))
+            except (OSError, ValueError, UnicodeError):
+                continue
+        completed.sort(key=lambda item: (item[0], item[1].name), reverse=True)
+        for _, directory in completed[self.keep:]:
+            # Never delete this attempt, including under an externally adjusted
+            # clock/mtime, or follow a directory replaced with a symlink.
+            if directory != self.path and not directory.is_symlink():
+                shutil.rmtree(directory)
+
+    def __exit__(self, exc_type, exc, traceback):
+        try:
+            # subprocess.TimeoutExpired retains partial output even though no
+            # CompletedProcess was returned. Preserve it when available.
+            if exc is not None and (getattr(exc, 'stdout', None) is not None or
+                                    getattr(exc, 'stderr', None) is not None):
+                self.record_backend(stdout=getattr(exc, 'stdout', None),
+                                    stderr=getattr(exc, 'stderr', None))
+            if exc is not None:
+                self._fields['exception_type'] = exc_type.__name__
+                self._fields['exception_message'] = str(exc)
+            query = self.path / 'query_scan.pcd'
+            if query.is_file() and not query.is_symlink():
+                digest = hashlib.sha256()
+                with query.open('rb') as stream:
+                    for block in iter(lambda: stream.read(1024 * 1024), b''):
+                        digest.update(block)
+                self._fields['query_sha256'] = digest.hexdigest()
+            rejected = self._fields.get('backend_returncode') not in (None, 0)
+            self._fields.update(
+                completed=True, completed_at=_utc_now(),
+                elapsed_sec=time.monotonic() - self._started,
+                outcome='rejected' if rejected else ('error' if exc is not None else 'success'))
+            self._save()
+        except Exception as evidence_error:
+            # The caller may already have published the accepted pose. Archival
+            # failure must not turn that accepted attempt into a REJECTED state.
+            # An incomplete record is retained, rather than claiming it is done.
+            logging.getLogger(__name__).warning(
+                'Could not finalize localization evidence: %s', evidence_error)
+        try:
+            self._prune()
+        except Exception as cleanup_error:
+            logging.getLogger(__name__).warning(
+                'Could not prune localization evidence: %s', cleanup_error)
+        return False
