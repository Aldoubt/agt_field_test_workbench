+std::string json_string(const std::string& value) {
+  std::ostringstream out;
+  out << '"';
+  for (const unsigned char c : value) {
+    if (c == '"' || c == '\\') out << '\\' << c;
+    else if (c == '\n') out << "\\n";
+    else if (c == '\r') out << "\\r";
+    else if (c == '\t') out << "\\t";
+    else if (c < 0x20) out << '?';
+    else out << c;
+  }
+  out << '"';
+  return out.str();
+}
+
+std::string json_number(double value) {
+  if (!std::isfinite(value)) return "null";
+  std::ostringstream out;
+  out << value;
+  return out.str();
+}
