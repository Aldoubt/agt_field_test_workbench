Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz_default_plugins/Map
    Name: Static Nav2 Map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Alpha: 0.65
    Draw Behind: true
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: true
    Topic:
      Value: /global_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Alpha: 0.35
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Topic:
      Value: /local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Alpha: 0.45
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Axes: true
    Show Names: false
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Odometry
    Name: FAST-LIO2 Local Odometry
    Enabled: true
    Topic:
      Value: /agt/odometry/local
    Keep: 1
    Shape:
      Value: Arrow
  - Class: rviz_default_plugins/PointCloud2
    Name: Filtered Obstacles (marking)
    Enabled: true
    Topic:
      Value: /agt/navigation/points_obstacles
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Queue Size: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 255; 145; 40
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw Navigation Cloud (clearing source)
    Enabled: false
    Topic:
      Value: /agt/livox/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Queue Size: 1
    Style: Points
    Size (Pixels): 1
    Color Transformer: FlatColor
    Color: 50; 220; 230
    Decay Time: 0
  - Class: rviz_default_plugins/Polygon
    Name: Local Costmap Footprint
    Enabled: true
    Topic:
      Value: /local_costmap/published_footprint
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Color: 235; 65; 65
    Alpha: 1
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Relocalization Pose
    Enabled: true
    Topic:
      Value: /agt/relocalization/pose
    Shape:
      Value: Arrow
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Topic:
      Value: /plan
    Line Style: Lines
    Line Width: 0.04
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Enabled: true
    Topic:
      Value: /local_plan
    Line Style: Lines
    Line Width: 0.05
  - Class: rviz_default_plugins/MarkerArray
    Name: Photo Waypoints
    Enabled: true
    Topic:
      Value: /agt/rviz_patrol/markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
  - Class: rviz_default_plugins/Image
    Name: Gimbal Camera
    Enabled: true
    Topic:
      Value: /cv_camera0/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Transport Hint: raw
    Normalize Range: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /agt/rviz_patrol/goal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 35
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1600
  Height: 900
