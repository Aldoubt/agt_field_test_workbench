<?xml version="1.0"?>
<package format="3">
  <name>agt_robot_studio</name>
  <version>0.1.0</version>
  <description>Standalone Qt5 operator console, live PointCloud2 visualization, mapping capture, and guarded motion tests.</description>
  <maintainer email="noreply@example.com">AGT Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
